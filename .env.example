# App configuration
# local, dev, prod
ENV=local
# debug, info, warn, error
LOGGER_LEVEL=debug
LOGGER_FOLDER=./out/logs
TIME_ZONE=UTC

# Server configuration
SERVER_PORT=8787
HTTP_ADDR=:8787
HTTP_SHUTDOWN_TIMEOUT=10s

# Database configuration
POSTGRES_HOST=expense-tracker-postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=expense_tracker
POSTGRES_TIMEOUT=5s

# Cache configuration
REDIS_HOST=expense-tracker-cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=
JWT_TTL=24h